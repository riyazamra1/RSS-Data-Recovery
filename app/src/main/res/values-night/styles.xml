<resources>
    <style name="Theme.RSSDataRecovery" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="Theme.RSSDataRecovery.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0D10</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/rss_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@style/Theme.RSSDataRecovery</item>
    </style>
</resources>